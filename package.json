{
  "name": "atlas-local",
  "productName": "Atlas",
  "version": "0.1.0",
  "description": "Offline worldbuilding app for writers and game masters",
  "main": "./out/main/index.js",
  "author": "Laderic",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:js": "electron-vite build",
    "build": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-mention": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-text-style": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@tiptap/suggestion": "^2.10.3",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.5.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "license": "MIT"
}